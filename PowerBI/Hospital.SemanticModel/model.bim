{
  "name": "Hospital",
  "compatibilityLevel": 1601,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "discourageImplicitMeasures": true,
    "tables": [
      {
        "name": "Department",
        "columns": [
          {
            "name": "DepartmentID",
            "dataType": "int64",
            "sourceColumn": "DepartmentID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "DepartmentName",
            "dataType": "string",
            "sourceColumn": "DepartmentName",
            "summarizeBy": "none"
          },
          {
            "name": "Location",
            "dataType": "string",
            "sourceColumn": "Location",
            "summarizeBy": "none"
          },
          {
            "name": "PhoneExtension",
            "dataType": "string",
            "sourceColumn": "PhoneExtension",
            "summarizeBy": "none"
          },
          {
            "name": "IsActive",
            "dataType": "boolean",
            "sourceColumn": "IsActive",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Department",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName, [CreateNavigationProperties=false]),",
                "    Rows = Source{[Schema=\"dbo\", Item=\"Department\"]}[Data]",
                "in",
                "    Rows"
              ]
            }
          }
        ]
      },
      {
        "name": "Medicine",
        "columns": [
          {
            "name": "MedicineID",
            "dataType": "int64",
            "sourceColumn": "MedicineID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "MedicineName",
            "dataType": "string",
