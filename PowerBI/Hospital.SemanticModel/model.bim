          },
          {
            "name": "AvailabilityStatus",
            "dataType": "string",
            "sourceColumn": "AvailabilityStatus",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Room",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName, [CreateNavigationProperties=false]),",
                "    Rows = Source{[Schema=\"dbo\", Item=\"Room\"]}[Data]",
                "in",
                "    Rows"
              ]
            }
          }
        ]
      },
      {
        "name": "Appointment",
        "columns": [
          {
            "name": "AppointmentID",
            "dataType": "int64",
            "sourceColumn": "AppointmentID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "PatientID",
            "dataType": "int64",
            "sourceColumn": "PatientID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "DoctorID",
            "dataType": "int64",
            "sourceColumn": "DoctorID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "DepartmentID",
            "dataType": "int64",
            "sourceColumn": "DepartmentID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "AppointmentDate",
            "dataType": "dateTime",
            "sourceColumn": "AppointmentDate",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "AppointmentTime",
            "dataType": "dateTime",
            "sourceColumn": "AppointmentTime",
            "summarizeBy": "none",
            "formatString": "HH:mm"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status",
            "summarizeBy": "none"
          },
          {
            "name": "Month",
            "dataType": "string",
            "type": "calculated",
            "expression": "FORMAT(Appointment[AppointmentDate], \"yyyy-MM\")",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Appointment",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName, [CreateNavigationProperties=false]),",
                "    Rows = Source{[Schema=\"dbo\", Item=\"Appointment\"]}[Data]",
                "in",
                "    Rows"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Appointments",
            "expression": "COUNTROWS(Appointment)",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Completed appointments",
            "expression": "CALCULATE([Appointments], KEEPFILTERS(Appointment[Status] = \"Completed\"))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Cancelled appointments",
            "expression": "CALCULATE([Appointments], KEEPFILTERS(Appointment[Status] = \"Cancelled\"))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Scheduled appointments",
            "expression": "CALCULATE([Appointments], KEEPFILTERS(Appointment[Status] = \"Scheduled\"))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Completion rate",
            "expression": "DIVIDE(COALESCE([Completed appointments], 0), [Completed appointments] + [Cancelled appointments])",
            "formatString": "0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Cancellation rate",
            "expression": "DIVIDE(COALESCE([Cancelled appointments], 0), [Completed appointments] + [Cancelled appointments])",
            "formatString": "0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Patients served",
            "expression": "CALCULATE(DISTINCTCOUNT(Appointment[PatientID]), KEEPFILTERS(Appointment[Status] = \"Completed\"))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Visits",
            "expression": "COUNTROWS(Medical_Record)",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Prescriptions",
            "expression": "COUNTROWS(Prescription)",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Billed amount",
            "expression": "SUM(Billing[TotalAmount])",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Collected amount",
            "expression": "CALCULATE([Billed amount], KEEPFILTERS(Billing[PaymentStatus] = \"Paid\"))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Outstanding amount",
            "expression": "CALCULATE([Billed amount], KEEPFILTERS(Billing[PaymentStatus] = \"Unpaid\"))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Collection rate",
            "expression": "DIVIDE(COALESCE([Collected amount], 0), [Billed amount])",
            "formatString": "0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Doctors with appointments",
            "expression": "DISTINCTCOUNT(Appointment[DoctorID])",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Department doctors",
            "expression": "CALCULATE(COUNTROWS(Doctor), TREATAS(VALUES(Department[DepartmentID]), Doctor[DepartmentID]))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Department staff",
            "expression": "COUNTROWS(Staff)",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Rooms",
            "expression": "COUNTROWS(Room)",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Occupied rooms",
            "expression": "CALCULATE([Rooms], KEEPFILTERS(Room[AvailabilityStatus] = \"Occupied\"))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Snapshot occupancy",
            "expression": "DIVIDE(COALESCE([Occupied rooms], 0), [Rooms])",
            "formatString": "0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Completed stays",
            "expression": "COUNTROWS(FILTER(Room_Assignment, NOT ISBLANK(Room_Assignment[DischargeDate])))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Average completed stay",
            "expression": "AVERAGEX(FILTER(Room_Assignment, NOT ISBLANK(Room_Assignment[DischargeDate])), DATEDIFF(Room_Assignment[AdmissionDate], Room_Assignment[DischargeDate], DAY))",
            "formatString": "0.0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Repeat patients",
            "expression": "COUNTROWS(FILTER(VALUES(Appointment[PatientID]), CALCULATE([Completed appointments]) > 1))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Completed YoY change",
            "expression": "VAR CurrentYear = CALCULATE([Completed appointments], KEEPFILTERS(YEAR(Appointment[AppointmentDate]) = 2025)) VAR PriorYear = CALCULATE([Completed appointments], KEEPFILTERS(YEAR(Appointment[AppointmentDate]) = 2024)) RETURN DIVIDE(CurrentYear - PriorYear, PriorYear)",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Outstanding over 90 days",
            "expression": "CALCULATE([Outstanding amount], KEEPFILTERS(Appointment[AppointmentDate] < DATE(2025, 10, 2)))",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Outstanding over 90 days share",
            "expression": "DIVIDE(COALESCE([Outstanding over 90 days], 0), [Outstanding amount])",
            "formatString": "0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Average bill per visit",
            "expression": "DIVIDE([Billed amount], [Visits])",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Visits per patient",
            "expression": "DIVIDE([Completed appointments], [Patients served])",
            "formatString": "0.0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Highest doctor workload",
            "expression": "MAXX(VALUES(Appointment[DoctorID]), [Completed appointments])",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Lowest doctor workload",
            "expression": "MINX(VALUES(Appointment[DoctorID]), [Completed appointments])",
            "formatString": "#,0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Average completed per doctor",
            "expression": "CALCULATE(DIVIDE([Completed appointments], [Doctors with appointments]), REMOVEFILTERS(Doctor))",
            "formatString": "#,0.0",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Highest doctor cancellation rate",
            "expression": "MAXX(VALUES(Appointment[DoctorID]), [Cancellation rate])",
            "formatString": "0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Cancellation rate all doctors",
            "expression": "CALCULATE([Cancellation rate], REMOVEFILTERS(Doctor))",
            "formatString": "0.0%",
            "displayFolder": "Hospital KPIs"
          },
          {
            "name": "Appointments note",
            "expression": "FORMAT(COALESCE([Scheduled appointments], 0), \"#,0\") & \" future bookings included\"",
            "displayFolder": "Card notes"
          },
          {
            "name": "Patients served note",
            "expression": "IF(ISBLANK([Visits per patient]), \"No data for this selection\", FORMAT([Visits per patient], \"0.0\") & \" completed visits per patient\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Collected note",
            "expression": "IF(ISBLANK([Collection rate]), \"No data for this selection\", FORMAT([Collection rate], \"0%\") & \" of billed amount\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Outstanding note",
            "expression": "IF(ISBLANK([Outstanding over 90 days share]), \"No data for this selection\", FORMAT([Outstanding over 90 days share], \"0%\") & \" is over 90 days old\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Completed note",
            "expression": "IF(ISBLANK([Completed YoY change]), \"Select both 2024 and 2025 months to compare years\", FORMAT([Completed YoY change], \"+0.0%;-0.0%;0.0%\") & \" in 2025 vs 2024\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Cancelled note",
            "expression": "IF(ISBLANK([Highest doctor cancellation rate]), \"No data for this selection\", \"Highest doctor rate \" & FORMAT([Highest doctor cancellation rate], \"0.0%\"))",
            "displayFolder": "Card notes"
          },
          {
            "name": "Scheduled note",
            "expression": "\"Booked after the Dec 31, 2025 snapshot\"",
            "displayFolder": "Card notes"
          },
          {
            "name": "Completion rate note",
            "expression": "\"Future bookings excluded\"",
            "displayFolder": "Card notes"
          },
          {
            "name": "Doctors note",
            "expression": "IF(ISBLANK([Highest doctor workload]), \"No data for this selection\", FORMAT([Lowest doctor workload], \"#,0\") & \"–\" & FORMAT([Highest doctor workload], \"#,0\") & \" completed per doctor\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Cancellation rate note",
            "expression": "IF(ISBLANK([Highest doctor cancellation rate]), \"No data for this selection\", \"Highest doctor \" & FORMAT([Highest doctor cancellation rate], \"0.0%\"))",
            "displayFolder": "Card notes"
          },
          {
            "name": "Billed note",
            "expression": "IF(ISBLANK([Average bill per visit]), \"No data for this selection\", FORMAT([Average bill per visit], \"#,0\") & \" per visit on average\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Collection rate note",
            "expression": "IF(ISBLANK([Outstanding amount]), \"No data for this selection\", FORMAT([Outstanding amount], \"#,0\") & \" still unpaid\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Completed stays note",
            "expression": "IF(ISBLANK([Average completed stay]), \"No data for this selection\", \"Average stay \" & FORMAT([Average completed stay], \"0.0\") & \" days\")",
            "displayFolder": "Card notes"
          },
          {
            "name": "Doctor workload color",
            "expression": "IF([Completed appointments] > [Average completed per doctor], \"#B3741D\", \"#6F8896\")",
            "displayFolder": "Highlight colors"
          },
          {
            "name": "Doctor cancellation color",
            "expression": "IF([Cancellation rate] > [Cancellation rate all doctors], \"#B3741D\", \"#6F8896\")",
            "displayFolder": "Highlight colors"
          }
        ]
      },
      {
        "name": "Medical_Record",
        "columns": [
          {
            "name": "RecordID",
            "dataType": "int64",
            "sourceColumn": "RecordID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "PatientID",
            "dataType": "int64",
            "sourceColumn": "PatientID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "DoctorID",
            "dataType": "int64",
            "sourceColumn": "DoctorID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "VisitDate",
            "dataType": "dateTime",
            "sourceColumn": "VisitDate",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Diagnosis",
            "dataType": "string",
            "sourceColumn": "Diagnosis",
            "summarizeBy": "none"
          },
          {
            "name": "TreatmentPlan",
            "dataType": "string",
            "sourceColumn": "TreatmentPlan",
            "summarizeBy": "none"
