        ],
        "partitions": [
          {
            "name": "Medicine",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName, [CreateNavigationProperties=false]),",
                "    Rows = Source{[Schema=\"dbo\", Item=\"Medicine\"]}[Data]",
                "in",
                "    Rows"
              ]
            }
          }
        ]
      },
      {
        "name": "Patient",
        "columns": [
          {
            "name": "PatientID",
            "dataType": "int64",
            "sourceColumn": "PatientID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "FirstName",
            "dataType": "string",
            "sourceColumn": "FirstName",
            "summarizeBy": "none"
          },
          {
            "name": "LastName",
            "dataType": "string",
            "sourceColumn": "LastName",
            "summarizeBy": "none"
          },
          {
            "name": "DateOfBirth",
            "dataType": "dateTime",
            "sourceColumn": "DateOfBirth",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "Gender",
            "dataType": "string",
            "sourceColumn": "Gender",
            "summarizeBy": "none"
          },
          {
            "name": "Address",
            "dataType": "string",
            "sourceColumn": "Address",
            "summarizeBy": "none"
          },
          {
            "name": "PhoneNumber",
            "dataType": "string",
            "sourceColumn": "PhoneNumber",
            "summarizeBy": "none"
          },
          {
            "name": "Email",
            "dataType": "string",
            "sourceColumn": "Email",
            "summarizeBy": "none"
          },
          {
            "name": "EmergencyContactName",
            "dataType": "string",
            "sourceColumn": "EmergencyContactName",
            "summarizeBy": "none"
          },
          {
            "name": "EmergencyContactPhone",
            "dataType": "string",
            "sourceColumn": "EmergencyContactPhone",
            "summarizeBy": "none"
          },
          {
            "name": "IsActive",
            "dataType": "boolean",
            "sourceColumn": "IsActive",
            "summarizeBy": "none"
          },
          {
            "name": "Age group at snapshot",
            "dataType": "string",
            "type": "calculated",
            "expression": "VAR Age = INT(YEARFRAC(Patient[DateOfBirth], DATE(2025, 12, 31), 1)) RETURN SWITCH(TRUE(), Age < 18, \"0–17\", Age < 30, \"18–29\", Age < 50, \"30–49\", Age < 70, \"50–69\", \"70+\")",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Patient",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName, [CreateNavigationProperties=false]),",
                "    Rows = Source{[Schema=\"dbo\", Item=\"Patient\"]}[Data]",
                "in",
                "    Rows"
              ]
            }
          }
        ]
      },
