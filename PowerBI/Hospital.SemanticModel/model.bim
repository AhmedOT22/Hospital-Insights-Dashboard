          },
          {
            "name": "Doctor name",
            "dataType": "string",
            "type": "calculated",
            "expression": "Doctor[FirstName] & \" \" & Doctor[LastName]",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Doctor",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, DatabaseName, [CreateNavigationProperties=false]),",
                "    Rows = Source{[Schema=\"dbo\", Item=\"Doctor\"]}[Data]",
