          },
          {
            "name": "FirstName",
            "dataType": "string",
            "sourceColumn": "FirstName",
            "summarizeBy": "none"
          },
          {
            "name": "LastName",
            "dataType": "string",
            "sourceColumn": "LastName",
            "summarizeBy": "none"
          },
          {
            "name": "Specialization",
            "dataType": "string",
            "sourceColumn": "Specialization",
            "summarizeBy": "none"
          },
          {
            "name": "PhoneNumber",
            "dataType": "string",
            "sourceColumn": "PhoneNumber",
            "summarizeBy": "none"
          },
          {
            "name": "Email",
            "dataType": "string",
            "sourceColumn": "Email",
            "summarizeBy": "none"
          },
          {
            "name": "DepartmentID",
            "dataType": "int64",
            "sourceColumn": "DepartmentID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Availability",
            "dataType": "boolean",
            "sourceColumn": "Availability",
            "summarizeBy": "none"
          },
          {
            "name": "IsActive",
            "dataType": "boolean",
            "sourceColumn": "IsActive",
