      {
        "name": "Room",
        "columns": [
          {
            "name": "RoomID",
            "dataType": "int64",
            "sourceColumn": "RoomID",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "RoomNumber",
            "dataType": "string",
            "sourceColumn": "RoomNumber",
            "summarizeBy": "none"
          },
          {
            "name": "DepartmentID",
            "dataType": "int64",
            "sourceColumn": "DepartmentID",
            "summarizeBy": "none",
